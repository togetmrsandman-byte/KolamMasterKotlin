    <string name="onboarding_begin">开始</string>
    <string name="history_title">历史</string>
    <string name="history_intro">Kolam 主要分为三类：Sikku Kolam、Pulli Kolam 和 Rangoli。</string>
    <string name="history_sikku_pulli_title">Sikku Kolam &amp; Pulli Kolam</string>
    <string name="history_sikku_origin_location">起源地：泰米尔纳德邦（印度南部）。</string>
    <string name="history_sikku_origin_story">起源故事：这些习俗起源于古代 Tamilakam 的史前部落和早期农耕社区，最初是出于生态与数学方面的需要。</string>
    <string name="history_ancient_dot_grids">古代泰米尔人用可食用的米粉绘制点阵（Pulli），为蚂蚁和鸟类提供食物。</string>
    <string name="history_loop_belief">他们相信闭合的线条能将恶灵困在门口，阻止其进入屋内，因此会连接或环绕这些点。</string>
    <string name="history_sikku_description">Sikku（或 Kambi）Kolam：先布点，但线条不能触碰这些点；而是用一条不断开的连续线在点周围曲折环绕。</string>
    <string name="history_pulli_description">Pulli Kolam：先排列点阵，再用直线或几何线条连接，组成星形、方形或花朵。</string>
    <string name="history_rangoli_title">Rangoli</string>
    <string name="history_rangoli_origin_location">起源地：马哈拉施特拉邦和中央邦（印度中部）。</string>
    <string name="history_rangoli_origin_story">起源故事：这一习俗起源于印度中部古代牧业和王室社区。它并非通过画线来困住灵体，而是发展成一种地面绘画（dhuli citra），用于装饰庭院，迎接节庆和王室庆典。人们不拘泥于固定点阵，而是用手指自由绘制动物、花朵和符号，再填上鲜艳的彩粉，使其宛如王室地毯。</string>
    <string name="history_sangam_title">Sangam 文学记载</string>
    <string name="history_sangam_description">早期泰米尔 Sangam 文学提到了装饰过的门口和庭院，表明当时已有装饰地面的习俗。</string>
    <string name="history_festival_title">节庆传统</string>
    <string name="history_festival_description">在节日和特别场合，人们会绘制更大、更精致的 Kolam，以庆祝节日并欢迎来访者。</string>
    <string name="history_modern_science_title">现代计算机科学的创意天地</string>
    <string name="history_modern_science_discovery">在 20 世纪 70 至 80 年代，由 Dr. Gift Siromoney 带领的 Madras Christian College 计算机科学家取得突破，认识到 Sikku Kolam 实际上是先进的视觉算法。</string>
    <string name="history_modern_science_languages">他们发现，围绕点连接线条的规则与计算机编程中使用的形式图像语言和数组文法高度吻合。</string>
    <string name="history_modern_science_research">如今，世界各地的研究人员利用 Kolam 结构研究结理论、图像逻辑、DNA 拼接模型以及先进的机器人轨迹规划。</string>
    <string name="history_brahma_timing_title">Brahma Muhurtam 时段</string>
    <string name="history_brahma_timing_description">Kolam 在传统上与 Brahma Muhurtam 这一吉祥时段相关，它大约在日出前 1.5 小时开始。</string>
    <string name="history_brahma_cultural_belief">从文化信仰来看，人们认为神灵会在此时经过大地，而空荡的门槛会让神灵绕过这户人家。</string>
    <string name="history_brahma_social_signal">从人类学角度看，它是一种社会信号：新绘制的 Kolam 告诉整个村庄，家中的女性已经起身且平安，家里也已准备好迎接社区。</string>
    <string name="history_photo_collection">欢迎通过我们的历史照片集，了解传统泰米尔乡村生活的点滴。</string>
</resources>
