    <string name="onboarding_kolam_history">சங்க இலக்கியங்களில் குறிப்பிடப்படும் கோலம், கி.மு. 500 காலத்திலிருந்தே வழக்கில் உள்ளது.</string>
    <string name="onboarding_begin">தொடங்கு</string>
    <string name="history_title">கோலத்தின் வரலாறு</string>
    <string name="history_intro">கோலத்தில் சிக்கு கோலம், புள்ளி கோலம், ரங்கோலி என மூன்று முக்கிய வகைகள் உள்ளன.</string>
    <string name="history_sikku_pulli_title">சிக்கு கோலம் &amp; புள்ளி கோலம்</string>
    <string name="history_sikku_origin_location">தோன்றிய இடம்: தமிழ்நாடு (தென்னிந்தியா).</string>
    <string name="history_sikku_origin_story">தோற்றம்: பழங்காலத் தமிழகம் பகுதியில் இருந்த வரலாற்றுக்கு முந்தைய பழங்குடி மற்றும் தொடக்ககால வேளாண் சமூகங்களில் இவ்வழக்கங்கள் தோன்றின. சூழலியல் மற்றும் கணிதத் தேவைகளால் அவை உருவாயின.</string>
    <string name="history_ancient_dot_grids">பறவைகளுக்கும் எறும்புகளுக்கும் உணவளிக்க, பண்டைய தமிழர்கள் அரிசி மாவால் புள்ளிக் கோலங்களை வரைந்தனர்.</string>
    <string name="history_loop_belief">மூடிய கோடுகள் தீய ஆவிகளை வீட்டு வாசலில் சிறைபிடித்து உள்ளே வராமல் தடுக்கும் என்று நம்பியதால், புள்ளிகளைச் சுற்றி கோடுகளை இணைத்தனர்.</string>
    <string name="history_sikku_description">Sikku (அல்லது Kambi) Kolam: புள்ளிகளை இடுங்கள்; கோடுகள் அவற்றைத் தொடக்கூடாது. இடைவிடாத ஒரே கோடு புள்ளிகளைச் சுற்றி வளைந்து செல்லும்.</string>
    <string name="history_pulli_description">Pulli Kolam: புள்ளி கட்டத்தை அமைத்து, நேர்கோடுகள் அல்லது வடிவியல் கோடுகளால் இணைத்து நட்சத்திரங்கள், சதுரங்கள் அல்லது மலர்களை உருவாக்குங்கள்.</string>
    <string name="history_rangoli_title">ரங்கோலி</string>
    <string name="history_rangoli_origin_location">தோன்றிய இடம்: மகாராஷ்டிரா மற்றும் மத்தியப் பிரதேசம் (மத்திய இந்தியா).</string>
    <string name="history_rangoli_origin_story">தோற்றம்: மத்திய இந்தியாவின் கால்நடை வளர்ப்பு மற்றும் அரசக் குடும்பச் சமூகங்களில் இந்த வழக்கம் தோன்றியது. ஆவிகளைச் சிறைபிடிக்கும் கோடுகளுக்குப் பதிலாக, திருவிழாக்களிலும் அரச விழாக்களிலும் முற்றங்களை அலங்கரிக்கும் தரை ஓவியமாக (dhuli citra) இது வளர்ந்தது. நிலையான புள்ளி கட்டமின்றி, மக்கள் விரல்களால் விலங்குகள், மலர்கள், குறியீடுகளைச் சுதந்திரமாக வரைந்து, அரச கம்பளங்களைப் போல் வண்ணத் தூளால் நிரப்பினர்.</string>
    <string name="history_sangam_title">சங்க இலக்கியக் குறிப்பு</string>
    <string name="history_sangam_description">பண்டைய தமிழ் சங்க இலக்கியங்களில் அலங்கரிக்கப்பட்ட நுழைவாயில்கள் மற்றும் முற்றங்கள் குறிப்பிடப்படுகின்றன. அந்தக் காலத்திலேயே தரை அலங்கரிக்கும் வழக்கம் இருந்ததை இது காட்டுகிறது.</string>
    <string name="history_festival_title">திருவிழா மரபுகள்</string>
    <string name="history_festival_description">திருவிழாக்களிலும் சிறப்பு நிகழ்வுகளிலும் கொண்டாட்டத்தைக் குறிக்கவும் விருந்தினர்களை வரவேற்கவும் கோலங்கள் பெரிதாகவும் விரிவாகவும் வரையப்படுகின்றன.</string>
    <string name="history_modern_science_title">நவீன கணினி அறிவியலுக்கான களமாக</string>
    <string name="history_modern_science_discovery">1970–80களில், டாக்டர் Gift Siromoney தலைமையிலான Madras Christian College கணினி விஞ்ஞானிகள், சிக்கு கோலங்கள் மேம்பட்ட காட்சிசார் படிமுறைகள் என்பதை உணர்ந்து முக்கிய முன்னேற்றம் செய்தனர்.</string>
    <string name="history_modern_science_languages">புள்ளிகளைச் சுற்றிக் கோடுகளை இணைக்கும் விதிகள், கணினி நிரலாக்கத்தில் பயன்படும் முறையான பட மொழிகள் மற்றும் அணிவரிசை இலக்கணங்களுடன் பொருந்துவதை அவர்கள் கண்டறிந்தனர்.</string>
    <string name="history_modern_science_research">இன்று உலகெங்கும் உள்ள ஆய்வாளர்கள் முடிச்சுக் கோட்பாடு, படத் தர்க்கம், DNA இணைப்பு மாதிரிகள், மேம்பட்ட ரோபோ இயக்கத் திட்டமிடல் ஆகியவற்றை ஆய்வு செய்ய கோல அமைப்புகளைப் பயன்படுத்துகின்றனர்.</string>
    <string name="history_brahma_timing_title">Brahma Muhurtam நேரம்</string>
    <string name="history_brahma_timing_description">கோலம், சூரிய உதயத்திற்கு சுமார் 1.5 மணி நேரத்திற்கு முன் தொடங்கும் மங்களகரமான Brahma Muhurtam எனும் நேரத்துடன் பாரம்பரியமாகத் தொடர்புடையது.</string>
    <string name="history_brahma_cultural_belief">கலாசார நம்பிக்கையின்படி, அந்த நேரத்தில் தெய்வங்கள் பூமியைக் கடந்து செல்வதாகவும், வாசல் காலியாக இருந்தால் வீட்டைக் கடந்து செல்வதாகவும் கருதப்பட்டது.</string>
    <string name="history_brahma_social_signal">மானுடவியல் நோக்கில், இது சமூகக் குறியீடாக இருந்தது: புதிதாக வரையப்பட்ட கோலம், வீட்டுப் பெண்கள் விழித்தும் பாதுகாப்பாகவும் இருப்பதையும், சமூகம் வர வீட்டுத் தயாராக இருப்பதையும் ஊருக்கு அறிவித்தது.</string>
    <string name="history_photo_collection">வரலாற்றுப் புகைப்படத் தொகுப்பில் பாரம்பரிய தமிழ் கிராம வாழ்க்கையின் காட்சிகளைப் பாருங்கள்.</string>
